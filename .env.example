# Copie para .env.local. Nunca versione a chave real.
APP_ORIGIN=http://localhost:3000
# test: qualquer e-mail, acesso por link. email: exige confirmação por e-mail.
ACCESS_MODE=test
# Lista separada por vírgulas de autores habilitados a importar documentos.
APP_AUTHOR_EMAILS=autora@empresa.com,autor@empresa.com
# Configuração legada: continua habilitando este e-mail e preserva seu nome.
APP_OWNER_EMAIL=voce@empresa.com
APP_OWNER_NAME=Seu nome
# Serviço de envio; use um remetente em domínio verificado.
RESEND_API_KEY=
MAIL_FROM=
