NODE_ENV=production
HOST=0.0.0.0
PORT=3000
MD_COLAB_DB_PATH=/data/md-colab.sqlite
ACCESS_MODE=email
APP_ORIGIN=https://md-colab.example.com
APP_AUTHOR_EMAILS=author@example.com
