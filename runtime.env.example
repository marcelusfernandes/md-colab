NODE_ENV=production
HOST=0.0.0.0
PORT=3000
MD_COLAB_DB_PATH=/data/md-colab.sqlite
ACCESS_MODE=email
APP_ORIGIN=https://collab.openprd.ai
APP_AUTHOR_MODE=open
APP_AUTHOR_EMAILS=author@example.com
APP_OWNER_EMAIL=author@example.com
APP_OWNER_NAME=Example Author
RESEND_API_KEY=replace-with-secret
MAIL_FROM=md-colab <access@example.com>
NOTIFICATION_DRAIN_LIMIT=10
NOTIFICATION_DRAIN_INTERVAL_MS=30000
NOTIFICATION_LEASE_SECONDS=60
NOTIFICATION_RETRY_BASE_SECONDS=30
MAX_OWNED_DOCUMENTS=250
MAX_COMMENTS_PER_DOCUMENT=5000
MAX_ACTIVE_SHARES_PER_DOCUMENT=500
