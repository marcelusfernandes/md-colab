{
  "name": "markdown-compartilhado",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:node": "node scripts/build-node.mjs",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "start:node": "node dist/standalone/server.js",
    "start:workers": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint app db lib scripts components/document-workspace.tsx components/email-login.tsx components/publishing-tokens.tsx tests",
    "format": "oxfmt",
    "db:generate": "drizzle-kit generate",
    "db:status:local": "node scripts/d1-local.mjs status",
    "db:migrate:local": "node scripts/d1-local.mjs migrate",
    "db:adopt-legacy:local": "node scripts/d1-local.mjs legacy",
    "db:recovery-check:local": "node scripts/d1-local-recovery-check.mjs",
    "db:node": "node --experimental-transform-types scripts/node-db.ts",
    "qa:node:fixture": "node --experimental-transform-types scripts/node-qa-fixture.ts",
    "test:node:smoke": "node scripts/node-runtime-smoke.mjs",
    "test": "node --experimental-transform-types --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "publish:markdown": "node scripts/md-colab-publish.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
